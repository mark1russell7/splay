{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/splay",
  "version": "0.2.0",
  "description": "Type-driven recursive renderer for any data: register a viewer per type and dispatch renders nested values with React, Vue, Solid, Svelte or plain strings. Framework-agnostic core, zero dependencies.",
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!dist/__tests__",
    "!src/**/*.test.ts",
    "!src/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "renderer",
    "recursive",
    "data-renderer",
    "type-dispatch",
    "dispatch",
    "registry",
    "framework-agnostic",
    "react",
    "vue",
    "solid",
    "svelte",
    "json-viewer",
    "ui",
    "layout",
    "visualization",
    "typescript",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/splay.git"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/splay/issues"
  },
  "homepage": "https://github.com/mark1russell7/splay#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@mark1russell7/cue": "^1.0.0",
    "vitest": "^3.0.0",
    "@mark1russell7/test": "github:mark1russell7/test#main"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
