{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "rootDir": "${configDir}"
  },
  "include": [
    "src/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "site"
  ]
}
