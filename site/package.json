{
  "$schema": "https://json.schemastore.org/package",
  "name": "@splay/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of splay: a live playground of dispatch with three viewer sets, and a live panel of the layout helpers.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/site-pages": "^0.1.10",
    "@mark1russell7/splay": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
